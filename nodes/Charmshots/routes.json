{
	"get_profile": {
		"method": "GET",
		"path": "/v1/account"
	},
	"list_photoshoots": {
		"method": "GET",
		"path": "/v1/photoshoots",
		"pagination": {
			"items": ["photoshoots"],
			"kind": "offset"
		}
	},
	"get_photoshoot": {
		"method": "GET",
		"path": "/v1/photoshoots/:photoshootId"
	},
	"list_photos": {
		"method": "GET",
		"path": "/v1/photoshoots/:photoshootId/photos",
		"pagination": {
			"items": ["photos"],
			"kind": "offset"
		}
	}
}
