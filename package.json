{
  "name": "n8n-nodes-charmshots",
  "version": "3.0.0",
  "description": "Native Charmshots REST API integration for n8n workflows.",
  "license": "MIT",
  "homepage": "https://charmshots.com",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "charmshots",
    "oauth",
    "automation"
  ],
  "author": {
    "name": "Charmshots",
    "url": "https://charmshots.com",
    "email": "saeedmshdi@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charmshots/n8n-nodes-charmshots.git"
  },
  "bugs": {
    "url": "https://github.com/charmshots/n8n-nodes-charmshots/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prepublishOnly": "npm run lint && npm test"
  },
  "files": [
    "dist",
    "examples"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/CharmshotsOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Charmshots/Charmshots.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.49.1",
    "typescript": "5.9.2",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "@types/node": "22.19.15"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
